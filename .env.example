API_HOST=127.0.0.1
API_PORT=8000
VITE_API_BASE=http://127.0.0.1:8000
VITE_WS_BASE=ws://127.0.0.1:8000

# Put a downloaded sherpa-onnx Chinese streaming CTC model here.
# Example: models/sherpa-onnx-streaming-zipformer-small-ctc-zh-int8-2025-04-01
SHERPA_MODEL_DIR=
SHERPA_PROVIDER=cpu
SHERPA_NUM_THREADS=2
SEGMENT_SILENCE_MS=1200
SEGMENT_MIN_AUDIO_MS=700
SEGMENT_ENERGY_THRESHOLD=550
